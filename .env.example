# =============================================================
# Smart Bus Management System - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================

# ----- Database -----
DATABASE_URL="postgresql://smartbus:smartbus_dev_pass@localhost:5432/smartbus_db"

# ----- JWT Secrets (generate with: openssl rand -hex 64) -----
JWT_ACCESS_SECRET=CHANGE_THIS_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Backend Server -----
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ----- Firebase (optional - for push notifications) -----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Set FIREBASE_ENABLED=false to skip Firebase initialization in development
FIREBASE_ENABLED=false

# ----- Google Maps (optional - for ETA calculation on backend) -----
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=false

# ----- Payment Gateway (Razorpay sandbox by default) -----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=CHANGE_THIS_RAZORPAY_SECRET
PAYMENT_SANDBOX=true

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ----- Logging -----
LOG_LEVEL=debug
